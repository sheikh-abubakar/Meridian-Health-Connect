NODE_ENV=development
HOST=0.0.0.0
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/meridian_health_connect?retryWrites=true&w=majority
# Optional separate cluster URI for tests. Tests always override dbName with a disposable *_test_* database.
TEST_MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
SEED_ADMIN_PASSWORD=replace-with-a-strong-demo-seed-password
GROQ_API_KEY=replace-with-your-groq-api-key
# Keep live provider tokens only in backend/.env (never commit them).
MOCEAN_API_TOKEN=YOUR_MOCEAN_TOKEN
MOCEAN_SMS_FROM=Meridian Health
MOCEAN_SMS_ENABLED=false
MOCEAN_DEFAULT_COUNTRY_CODE=92
MOCEAN_DLR_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
MOCEAN_DLR_PUBLIC_URL=https://meridian-health-api.duckdns.org/api/webhooks/mocean/sms-dlr
# Clinical attachments: production EC2 uses an IAM role; do not add AWS access keys here.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=stagepass-media-abubakar-2026
S3_ATTACHMENT_PREFIX=meridian-health
#pm2 restart meridian-api --update-env
# ssh -i D:\stagepass-key.pem ubuntu@13.235.80.159
