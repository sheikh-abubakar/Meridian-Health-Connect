NODE_ENV=development
HOST=0.0.0.0
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/meridian_health_connect?retryWrites=true&w=majority
# Optional separate cluster URI for tests. Tests always override dbName with a disposable *_test_* database.
TEST_MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
SEED_ADMIN_PASSWORD=replace-with-a-strong-demo-seed-password
GROQ_API_KEY=replace-with-your-groq-api-key
